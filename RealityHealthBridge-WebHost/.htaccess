# REALITY HEALTH BRIDGE - web server rules for the app folder (public_html)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use https (needed for offline mode, the install button and password security).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Folders and files that are for you only, never for visitors.
  RewriteRule ^(database|apps-script|supabase|netlify)(/|$) - [F,L]
  RewriteRule ^(README\.txt|DEPLOY\.md|netlify\.toml)$ - [F,L]
</IfModule>

# The app's install file.
AddType application/manifest+json .webmanifest
<Files "manifest.json">
  ForceType application/manifest+json
</Files>

# Always check for a newer copy of these, so an upload reaches every phone quickly.
# (Offline, the service worker still serves its saved copy.)
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|privacy\.html|terms\.html|service-worker\.js|config\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
